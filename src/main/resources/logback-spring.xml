<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="APPLICATION_NAME"
                    source="spring.application.name" defaultValue="househost"/>
    <springProperty scope="context" name="ENVIRONMENT"
                    source="househost.logging.environment" defaultValue="development"/>
    <springProperty scope="context" name="LOG_PATH"
                    source="househost.logging.path" defaultValue="./logs"/>
    <springProperty scope="context" name="MAX_FILE_SIZE"
                    source="househost.logging.max-file-size" defaultValue="20MB"/>
    <springProperty scope="context" name="MAX_HISTORY"
                    source="househost.logging.max-history" defaultValue="30"/>
    <springProperty scope="context" name="GENERAL_TOTAL_SIZE_CAP"
                    source="househost.logging.general-total-size-cap" defaultValue="1536MB"/>
    <springProperty scope="context" name="ERROR_TOTAL_SIZE_CAP"
                    source="househost.logging.error-total-size-cap" defaultValue="512MB"/>
    <springProperty scope="context" name="ROOT_LOG_LEVEL"
                    source="logging.level.root" defaultValue="INFO"/>
    <springProperty scope="context" name="HOUSEHOST_LOG_LEVEL"
                    source="logging.level.com.househost" defaultValue="INFO"/>

    <property name="LOG_PATTERN"
              value="timestamp=%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%level service=${APPLICATION_NAME}-backend environment=${ENVIRONMENT} correlationId=%X{correlationId:-none} logger=%logger{48} message=&quot;%replace(%msg){'[\r\n\t]+',' '}&quot; exception=&quot;%replace(%ex){'[\r\n\t]+',' | '}&quot;%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="GENERAL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/househost.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/househost-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${GENERAL_TOTAL_SIZE_CAP}</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <file>${LOG_PATH}/househost-error.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/househost-error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${ERROR_TOTAL_SIZE_CAP}</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <logger name="com.househost" level="${HOUSEHOST_LOG_LEVEL}"/>
    <logger name="org.springframework.boot.autoconfigure.security.servlet.UserDetailsServiceAutoConfiguration"
            level="ERROR"/>

    <springProfile name="dev">
        <logger name="com.househost" level="DEBUG"/>
    </springProfile>

    <springProfile name="prod">
        <logger name="com.househost" level="INFO"/>
        <logger name="org.hibernate" level="WARN"/>
        <logger name="org.springframework.security" level="WARN"/>
    </springProfile>

    <root level="${ROOT_LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="GENERAL_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
</configuration>
